@page "/catalog"
@model AgentPortal.Pages.CatalogModel
@{ ViewData["Title"] = "Catalog"; }
<section class="page-heading"><div><p class="eyebrow">YOUR WHOLESALE WORKSPACE</p><h1>Stock up. Stay ahead.</h1><p>Explore the collection and build your next bulk order.</p></div><a class="outline" asp-page="/Orders/Index">Order history ↗</a></section>
<div class="catalog-banner"><div><span class="pill">THE EVERYDAY COLLECTION</span><h2>Essentials with a little extra joy.</h2><p>A shelf full of good things. One order full of possibilities.</p></div><div class="catalog-mascot nova-catalog"><img src="/media/nova-3d-v2.webp" alt="Nova welcomes you to the collection" width="1200" height="1334" /></div></div>
<div class="stats-grid"><div class="stat"><span>Available products</span><strong>@Model.Items.Count(x => x.Stock > 0) <small>ready to order</small></strong></div><div class="stat"><span>Low stock</span><strong>@Model.Items.Count(x => x.Stock <= 10) <small>products at ≤ 10 units</small></strong></div><div class="stat"><span>Ordering</span><strong>One checkout <small>multiple product lines</small></strong></div></div>
@if (!string.IsNullOrEmpty(Model.Error)) { <div class="alert" role="alert">@Model.Error</div> }
<form method="post" class="catalog-order" data-order-form>
<input asp-for="RequestKey" type="hidden" />
<div class="card catalog-card"><div class="table-toolbar"><div><h2>Product catalog <span class="count">@Model.Items.Count</span></h2><p>Choose quantities to add to your order.</p></div><label class="search-field"><span class="sr-only">Search products</span><span aria-hidden="true">⌕</span><input id="catalog-search" type="search" placeholder="Search products…" /></label></div>
<div class="catalog-controls"><div class="category-tabs" role="group" aria-label="Filter category"><button type="button" class="active" data-category-filter="">All essentials</button><button type="button" data-category-filter="Coffee &amp; tea">Coffee &amp; tea</button><button type="button" data-category-filter="Pantry">Pantry</button><button type="button" data-category-filter="Snacks">Snacks</button><button type="button" data-category-filter="Drinks">Drinks</button></div><div class="view-toggle" role="group" aria-label="Catalog view"><button type="button" data-catalog-view="grid" aria-pressed="true">▦ Cards</button><button type="button" data-catalog-view="list" aria-pressed="false">☷ List</button></div></div><div class="table-scroll"><table class="catalog-table catalog-grid"><thead><tr><th>Product</th><th>Pack size</th><th>Unit price</th><th>Availability</th><th>Quantity</th></tr></thead><tbody>
@foreach (var item in Model.Items) {
var value = Model.Quantities.GetValueOrDefault(item.Id);
<tr data-product data-category="@AgentPortal.ProductVisual.Category(item.Name)" data-search="@item.Name.ToLowerInvariant() @item.Size.ToLowerInvariant()"><td><div class="product-cell"><img class="product-photo" src="@AgentPortal.ProductVisual.Photo(item.Name)" alt="@item.Name — illustrative product image" loading="lazy" /><span><strong>@item.Name</strong><small>NS-@item.Id.ToString("D3")</small></span></div></td><td>@item.Size</td><td class="money">@item.Price.ToString("N0")<small>VND / unit</small></td><td><span class="stock @(item.Stock == 0 ? "out" : item.Stock <= 10 ? "low" : "")"><i></i>@(item.Stock == 0 ? "Out of stock" : $"{item.Stock} in stock")</span></td><td><div class="stepper"><button type="button" data-step="-1" aria-label="Decrease @item.Name quantity">−</button><input class="quantity" name="qty_@item.Id" data-price="@item.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)" type="number" min="0" max="@item.Stock" value="@value" aria-label="Quantity for @item.Name" disabled="@(item.Stock == 0)" /><button type="button" data-step="1" aria-label="Increase @item.Name quantity" disabled="@(item.Stock == 0)">+</button></div></td></tr>
}
</tbody></table></div><p class="empty-search" hidden>No matching products. Try another name or pack size.</p>
@if (Model.Items.Count == 0 && Model.Error is null) { <div class="empty-state"><h3>The next collection is on its way.</h3><p>Check back shortly or contact your warehouse administrator.</p></div> }
<div class="catalog-note">ⓘ Ingredient photography is illustrative. Pack sizes, prices, and stock are confirmed at checkout.</div></div>
<aside class="card order-summary"><p class="eyebrow">YOUR NEXT DELIVERY</p><h2>Order summary</h2><p>Select products from the catalog to get started.</p><div id="selected-lines" class="selected-lines"><p>No products selected yet.</p></div><dl><div><dt>Product lines</dt><dd id="line-count">0</dd></div><div><dt>Total units</dt><dd id="unit-count">0</dd></div></dl><div class="order-total"><span>Order total</span><strong id="order-total">0 VND</strong></div><button class="primary wide" type="submit">Place order <span aria-hidden="true">→</span></button><p class="fine-print">Checkout reserves stock. Confirm a classroom-only payment on the invoice; no real money moves.</p><button class="text-link" type="button" id="clear-order">Clear selection</button><p id="order-live" class="sr-only" aria-live="polite"></p></aside>
</form>
