digraph G {graph[rankdir=TB,bgcolor=white,pad=.3];node[shape=record,fontname="Arial",fontsize=10,style=filled,fillcolor="#EFF5EC",color="#35745B"];Agent[label="{Agent|PK AgentID : int\lAgentName / Address / Phone (unique)\lIsActive : bit\l}"];User[label="{Users|PK UserID : int\lUserName / Email (unique)\lPasswordHash / IsLocked / FailedLoginCount\lRole : Admin or Agent\lFK AgentID : int nullable\l}"];Order[label="{Order|PK OrderID : int\lOrderDate : datetime2 UTC\lFK AgentID : int\lOrderStatus\lRequestKey : uniqueidentifier (unique when set)\l}"];Detail[label="{OrderDetail|PK ID : int\lFK OrderID / ItemID\lQuantity : int positive\lUnitAmount : decimal(12,2) positive\lUNIQUE (OrderID,ItemID)\l}"];Item[label="{Item|PK ItemID : int\lItemName / Size\lPrice : decimal(12,2) positive\lStockQuantity : int non-negative\lIsActive / RowVersion\l}"];Agent->Order[label="1 to 0..* / no cascade delete"];Agent->User[label="1 to 0..* / nullable for Admin"];Order->Detail[label="1 to 1..* / cascade delete"];Item->Detail[label="1 to 0..* / restrict delete"];}
