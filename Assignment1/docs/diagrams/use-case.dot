digraph G {graph[rankdir=LR,bgcolor=white,pad=.3];node[fontname="Arial",fontsize=10,style=filled,fillcolor="#EFF5EC",color="#35745B"];P[shape=plaintext,label="Passenger"];O[shape=plaintext,label="Operator"];Card[shape=box,label="Card acquirer"];Qr[shape=box,label="Bank / wallet gateway"];Routes[shape=box,label="Route source"];subgraph cluster_k{label="Ticket vending machine";node[shape=ellipse];Buy[label="UC-01 Buy ticket"];PayCard[label="UC-02 Pay by card"];PayQr[label="UC-03 Pay by bank / wallet QR"];Diag[label="UC-04 Diagnose kiosk"];Recon[label="UC-05 Reconcile transaction"];Select[label="UC-06 Select destination"];Method[label="UC-07 Choose payment"];Print[label="UC-08 Print ticket"];Receipt[label="UC-09 View receipt"];Buy->Select[style=dashed,label="<<include>>"];Buy->Method[style=dashed,label="<<include>>"];Buy->Print[style=dashed,label="<<include>>"];Buy->Receipt[style=dashed,label="<<include>>"];PayCard->Buy[style=dashed,label="<<extend>>"];PayQr->Buy[style=dashed,label="<<extend>>"];}P->Buy;O->Diag;O->Recon;Card->PayCard;Qr->PayQr;Routes->Select;}