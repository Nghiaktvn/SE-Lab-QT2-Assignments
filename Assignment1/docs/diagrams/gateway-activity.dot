digraph G { graph [rankdir=TB,bgcolor=white,pad=.2]; node [fontname="Arial",fontsize=10,style=filled,fillcolor="#EDF4FA",color="#2470A5",shape=box]; tvm [label="TVM\nCreate idempotent transaction\nSend amount and callback URL"]; gateway [label="Payment gateway\nAuthenticate merchant\nAuthorize / capture\nSend signed callback"]; verify [shape=diamond,label="Signature, amount, and key valid?"]; approve [label="Persist Paid once\nIssue ticket"]; reject [label="Persist decline / unknown\nReconcile; do not issue"]; tvm->gateway->verify; verify->approve [label="approved"]; verify->reject [label="invalid / declined / duplicate"]; }
