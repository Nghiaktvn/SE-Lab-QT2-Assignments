digraph G {graph[rankdir=TB,bgcolor=white,pad=.3];node[shape=record,fontname="Arial",fontsize=10,style=filled,fillcolor="#EFF5EC",color="#35745B"];
UI[label="{TicketMachineForm|Begin / Complete / Reconcile / Refund\l}"];Store[label="{TicketStore|Routes()\lSave(transaction)\lUpdate(transaction, printStatus, refund)\l}"];Tx[label="{TicketTransaction|Id: Guid\lIdempotencyKey: string\lDestination: Destination\lFareSnapshot: decimal\lPaymentMethod\lStatus: TransactionStatus\l|MarkPaid(reference)\lMarkUnknown() / MarkDeclined()\lCancel()\lIssueTicket(expiry)\lPrinterFailed() / Reprint() / Refund()\l}"];Destination[label="{Destination|Code / Name\lFare: decimal\lIsActive: bool\l}"];Ticket[label="{Ticket|TicketId: Guid\lBarcode: string\lValidUntil: DateTimeOffset\lPrintStatus\l}"];SQL[shape=cylinder,label="MSSQL\nDestination + TicketTransaction"];UI->Tx[label="orchestrates"];UI->Store;Store->SQL;Tx->Destination[label="1 immutable snapshot"];Tx->Ticket[label="1 owns 0..1"];}
