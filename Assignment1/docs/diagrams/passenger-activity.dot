digraph G { graph [rankdir=TB,bgcolor=white,pad=.2]; node [fontname="Arial",fontsize=10,style=filled,fillcolor="#EDF4FA",color="#2470A5",shape=box]; start [shape=oval,label="Passenger presses Start"]; routes [label="Load active destinations and fares"]; select [label="Select destination and confirm fare"]; method [label="Choose card or wallet QR"]; pay [shape=diamond,label="Payment approved?"]; issue [label="Persist paid transaction and print barcode ticket"]; print [shape=diamond,label="Printer succeeds?"]; receipt [label="Show success receipt"]; recovery [label="Reconcile payment; retry, reprint, or refund"]; decline [label="Show decline / timeout guidance"]; end [shape=oval,label="End"]; start->routes->select->method->pay; pay->issue [label="yes"]; pay->decline [label="no / unknown"]; decline->end; issue->print; print->receipt [label="yes"]; print->recovery [label="no"]; receipt->end; recovery->end; }
