digraph G { graph [rankdir=LR,bgcolor=white,pad=.2]; node [fontname="Arial",fontsize=9,shape=box,style=filled,fillcolor="#EDF4FA",color="#2470A5"]; p [label="Passenger"]; ui [label="TVM UI"]; service [label="Purchase Service"]; route [label="Route Catalog"]; gateway [label="Payment Adapter"]; db [shape=cylinder,label="Ticket Repository"]; printer [label="Printer"]; p->ui [label="route + method"]; ui->service [label="purchase() "]; service->route [label="get route / fare"]; route->service [label="fare snapshot"]; service->db [label="save Pending"]; service->gateway [label="authorize(amount,key)"]; gateway->service [label="approved + reference"]; service->db [label="mark Paid"]; service->printer [label="print barcode ticket"]; printer->service [label="print result"]; service->ui [label="receipt + status"]; ui->p [label="ticket / guidance"]; }
