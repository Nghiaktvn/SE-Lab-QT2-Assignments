digraph G { graph [rankdir=TB,bgcolor=white,pad=.2]; node [fontname="Arial",fontsize=9,shape=box,style="rounded,filled",fillcolor="#EDF4FA",color="#2470A5"]; start [shape=point]; idle [label="Idle"]; selecting [label="Selecting"]; awaiting [label="Awaiting Payment"]; auth [label="Authorizing"]; unknown [label="Payment Unknown"]; declined [label="Declined"]; paid [label="Paid"]; printing [label="Printing"]; done [label="Completed: ticket issued\nPrintStatus: Pending"]; compensation [label="Compensation Required"]; refunded [label="Refunded"]; start->idle; idle->selecting [label="Start"]; selecting->awaiting [label="route confirmed"]; awaiting->auth [label="submit / QR"]; auth->paid [label="approved"]; auth->declined [label="rejected"]; auth->unknown [label="timeout"]; unknown->paid [label="reconcile approved"]; unknown->declined [label="reconcile rejected"]; declined->awaiting [label="retry"]; paid->done [label="IssueTicket / SQL save"]; done->printing [label="print preview"]; printing->done [label="preview closed"]; done->compensation [label="simulated printer fault"]; compensation->done [label="reprint"]; compensation->refunded [label="refund"]; done->idle [label="new transaction"]; refunded->idle; }
